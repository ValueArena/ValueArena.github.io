ENVIRONMENT=production
# Direct/session connection: scheduler advisory lock requires session affinity.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@SESSION_POOLER:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=evaluation-results
ALLOWED_ORIGINS=https://valuearena.github.io
# Generate with: openssl rand -hex 32. Use the same value on API and scheduler.
WORKER_SECRET=
API_PUBLIC_URL=https://YOUR-API.up.railway.app
RUNPOD_API_KEY=
# Publish Dockerfile.worker and use its sha256 digest, not a mutable latest tag.
WORKER_IMAGE=
RUNPOD_GPU_TYPE=NVIDIA A40
RUNPOD_GPU_COUNT=1
RUNPOD_DISK_GB=100
MAX_RUNNING_JOBS=1
OPENROUTER_API_KEY=
HF_TOKEN=
MODEL_CATALOG_PATH=catalog.json
MAX_ARTIFACT_BYTES=50000000
# Scheduler only: dataset write token. Never sent to GPU workers.
HF_PUBLISH_TOKEN=
HF_RESULTS_REPO=invi-bhagyesh/ValueArena
