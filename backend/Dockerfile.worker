# Reuse the verified CUDA toolkit and GPU dependency image.
FROM ghcr.io/valuearena/evaluation-worker@sha256:66adcf3c9f6672826eba35cab072e8d5e5db3cbe67fcf2c71dac5a76ae4d533d
ARG EIGENBENCH_REVISION=a513fbfa2f8520ec6d8f470143d7052c76c31147
RUN cd /opt/eigenbench \
    && git remote set-url origin https://github.com/jchang153/EigenBench.git \
    && git fetch origin "$EIGENBENCH_REVISION" \
    && git checkout --detach "$EIGENBENCH_REVISION"
WORKDIR /app
COPY requirements-worker.txt .
RUN pip install --no-cache-dir -r requirements-worker.txt \
    && pip check
RUN python -c "import torch, transformers, vllm; print('GPU stack:', torch.__version__, torch.version.cuda, transformers.__version__, vllm.__version__)"
COPY app app
ENV EIGENBENCH_ROOT=/opt/eigenbench PYTHONUNBUFFERED=1 HF_HOME=/workspace/hf MPLBACKEND=Agg
RUN python -m app.upstream && python -m app.check_compiler && python -m app.check_cuda_compiler \
    && python -c "from inspect_ai.model._providers.vllm import VLLM_DEFAULT_SERVER_ARGS as v; assert v == 'VLLM_DEFAULT_SERVER_ARGS'"
CMD ["python", "-m", "app.worker"]
