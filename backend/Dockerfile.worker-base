# CUDA development files are required for FlashInfer's runtime compilation.
FROM nvidia/cuda:13.0.2-devel-ubuntu22.04@sha256:6b6617592b94e7dcc6ffbe6d00720eed27bc6e3b4f06b26b93b4070c31f57391 AS cuda-toolkit
# Build from this backend directory. CI/release should publish by immutable digest.
FROM python:3.11-slim
COPY --from=cuda-toolkit /usr/local/cuda-13.0 /usr/local/cuda
ENV CUDA_HOME=/usr/local/cuda PATH=/usr/local/cuda/bin:$PATH LD_LIBRARY_PATH=/usr/local/cuda/lib64
ARG EIGENBENCH_REVISION=5e7520f71fd74fb3c884ae1a02534c8489348dbd
RUN apt-get update && apt-get install -y --no-install-recommends git libgomp1 build-essential && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/jchang153/EigenBench.git /opt/eigenbench \
    && cd /opt/eigenbench && git checkout "$EIGENBENCH_REVISION"
# Pin the runner source; resolve GPU dependencies when building, then deploy an immutable image.
RUN pip install --no-cache-dir -r /opt/eigenbench/requirements.txt
WORKDIR /app
COPY requirements-worker.txt .
RUN pip install --no-cache-dir -r requirements-worker.txt \
    && pip check
RUN python -c "import torch, transformers, vllm; print('GPU stack:', torch.__version__, torch.version.cuda, transformers.__version__, vllm.__version__)"
COPY app app
ENV EIGENBENCH_ROOT=/opt/eigenbench PYTHONUNBUFFERED=1 HF_HOME=/workspace/hf MPLBACKEND=Agg
RUN python -m app.upstream && python -m app.check_compiler && python -m app.check_cuda_compiler
CMD ["python", "-m", "app.worker"]
